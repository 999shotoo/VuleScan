{
  "name": "vulscan-cli",
  "version": "1.0.5",
  "description": "Advanced vulnerability scanner CLI - port scanning, subdomain discovery, brute force, directory search and more",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "vulscan": "dist/index.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "node --loader ts-node/esm src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist",
    "check-types": "tsc --noEmit -p tsconfig.json"
  },
  "files": [
    "dist",
    "wordlists"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "keywords": [
    "vulnerability",
    "scanner",
    "cli",
    "security",
    "pentest",
    "port-scan",
    "subdomain",
    "bruteforce"
  ],
  "license": "MIT",
  "dependencies": {
    "inquirer": "^9.2.12",
    "ssh2": "^1.17.0"
  },
  "devDependencies": {
    "@types/inquirer": "^8.2.10",
    "@types/node": "^20.10.6",
    "tsup": "^8.5.1",
    "typescript": "^5.3.3"
  }
}
