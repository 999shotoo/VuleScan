{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "lib": ["ES2020"],
    "moduleResolution": "node",
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "composite": true,
    "paths": {
      "@avs-cli/*": ["./packages/*/src", "./modules/*/src"]
    }
  },
  "references": [
    { "path": "./packages/core" },
    { "path": "./modules/bruteforce" },
    { "path": "./modules/directory-search" },
    { "path": "./modules/encryption-analyzer" },
    { "path": "./modules/internet-archive" },
    { "path": "./modules/Network-scan" },
    { "path": "./modules/subdomain" }
  ],
  "exclude": ["node_modules", "dist"]
}

