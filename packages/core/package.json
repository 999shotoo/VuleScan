{
  "name": "@avs-cli/core",
  "version": "1.0.0",
  "description": "AVS CLI Core - Main CLI and menu system",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "avs-cli": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "node --loader ts-node/esm src/index.ts",
    "start": "node dist/index.js",
    "clean": "rm -rf dist"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@avs-cli/bruteforce": "*",
    "@avs-cli/directory-search": "*",
    "@avs-cli/encryption-analyzer": "*",
    "@avs-cli/internet-archive": "*",
    "@avs-cli/network-scan": "*",
    "@avs-cli/subdomain": "*",
    "chalk": "^5.3.0",
    "inquirer": "^9.2.12"
  },
  "devDependencies": {
    "@types/inquirer": "^8.2.10",
    "@types/node": "^20.10.6",
    "typescript": "^5.3.3"
  }
